# Content Lab — local development environment example
# Copy to .env.local and fill in values.
# No variable has an implicit default in production, staging, or development.
# Every deployment must explicitly configure INTELLIGENCE_PROVIDER.

# ── Supabase local ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ── FastAPI local ─────────────────────────────────────────────────────────────
FASTAPI_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ENVIRONMENT=development

# ── Intelligence provider ─────────────────────────────────────────────────────
# Required — no implicit default.
# development/test: fake (no cost)
# staging/production: claude (requires ANTHROPIC_API_KEY)
INTELLIGENCE_PROVIDER=fake
ANTHROPIC_API_KEY=

# Per-operation model overrides (optional — defaults to claude-sonnet-5)
# CLAUDE_MODEL_ANALYZE_EXPERIMENT=claude-opus-4-8
# CLAUDE_MODEL_GENERATE_CANDIDATES=claude-opus-4-8
