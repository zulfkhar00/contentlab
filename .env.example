# Content Lab local dev
# Only OPENROUTER_API_KEY needs to be filled in.
# All other values are pre-set for local Docker use.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Safe defaults for local dev — do not use in production
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
VISITOR_HMAC_SECRET=dev-hmac-secret-padded-to-exactly-32ch
