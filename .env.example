# Required -- fill these in before running make up

# OpenRouter API key -- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase JWT secret -- must be at least 32 characters
# For local dev you can use this exact string:
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Visitor HMAC secret -- generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VISITOR_HMAC_SECRET=dev-hmac-secret-padded-to-exactly-32-chars!
